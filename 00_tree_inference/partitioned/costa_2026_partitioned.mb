begin mrbayes;
	log start filename = costa_et_al_2026.log;
	execute costa_2026_partitioned.nex;
	set autoclose=yes nowarn=yes;
	outgroup Polypterus_senegalus;
	taxastat;
	charset morphGEN=1-7;
	charset morphSKULL=8-23;
	charset morphTEETH=24-44;
	charset morphAX=45-52;
	charset morphCAU=53-60;
	charset morphFIN=61-75;
	charset morphSC=76-86;
	charset morphCSC=87-101;
	charset morphCLO=102-106;
	partition combined=9: morphGEN, morphSKULL, morphTEETH, morphAX, morphCAU, morphFIN, morphSC, morphCSC, morphCLO;
	set partition = combined;
	lset applyto=(all) rates=invgamma;     
	lset coding=variable;
	unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all); 
	prset applyto=(all) ratepr=variable;
	showmodel;
	mcmcp ngen= 30000000 relburnin=yes burninfrac=0.25 printfreq=1000  samplefreq=1000 nchains=4 savebrlens=yes nruns=4;
	mcmc;
	plot;
	sump;
	sumt;
	log stop;
end;